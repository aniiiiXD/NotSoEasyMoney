# Generate a unique local secret, e.g. with: openssl rand -base64 32
AUTH_SECRET=

# Development only. The server is bound to 127.0.0.1 when using npm run dev.
LOCAL_TEST_LOGIN=true

# Optional: create a Google OAuth web client and set these to enable Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: comma-separated account IDs authorized to see aggregate analytics.
ANALYTICS_ADMIN_USER_IDS=
