# Neon: use the pooled connection for the app and the direct connection to the
# same database for migrations. Keep both URLs private.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Generate a unique session secret, e.g. with: openssl rand -base64 32
AUTH_SECRET=

# Create a Google OAuth web client and set these to enable Google sign-in.
# Local credentials and exact localhost callback URIs must be configured separately.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The HTTPS origin used for referral and QR links; loopback HTTP is allowed locally.
# Change the port if your local development server uses another port.
APP_URL=http://127.0.0.1:3000

# Optional: comma-separated account IDs authorized to see aggregate analytics.
ANALYTICS_ADMIN_USER_IDS=

# Exact Google account IDs permitted to manage influencer links and view counts.
REFERRAL_ADMIN_USER_IDS=

# Exact Google account IDs permitted to open the operational observability dashboard.
OBSERVABILITY_ADMIN_USER_IDS=

# Razorpay Standard Checkout. Use test keys locally; never expose KEY_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Default OFF. Only enable after live merchant approval, migration and webhook setup.
DISCOVERY_PAYWALL_ENABLED=false
# Price per new introduction in paise: 2000 = INR 20.
DISCOVERY_PRICE_PAISE=2000
# A separate random webhook signing secret, matching the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
