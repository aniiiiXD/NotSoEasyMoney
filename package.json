{
  "name": "mystery-match",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "referrals": "node --env-file-if-exists=.env.local scripts/referrals.mjs",
    "safety-reports": "node --env-file-if-exists=.env.local scripts/safety-reports.mjs",
    "payments:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-payments.mjs"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.2",
    "next": "16.4.2",
    "next-auth": "beta",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  }
}
